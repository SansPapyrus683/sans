{
    "extractor": {
        "twitter":{
            "filename": "{author[name]}_{tweet_id}_{num}.{extension}",
            "cookies": ["edge"],
            "retweets": true,
            "directory": ["{user[name]}"],
            "tweet": {
                "directory": ["misc"]
            }
        },
        "lofter": {
            "cookies": ["edge"],
            "blog-posts": {
                "filename": "{citeParentBlogInfo[blogName]}_{permalink}_{num}.{extension}"
            },
            "post": {
                "filename": "{blogInfo[blogName]}_{permalink}_{num}.{extension}"
            },
            "directory": ["lofter"]
        },
        "bluesky": {
            "reposts": true,
            "filename": "{author[handle]}_{post_id}_{num}.{extension}",
            "directory": ["bluesky"]
        },
        "tumblr": {
            "directory": ["tumblr"],
            "filename": "{reblogged_root_name}_{id}_{num}.{extension}"
        }
    },
    "downloader": {

    },
    "output": {

    },
    "postprocessor": {

    }
}
